# Maintainer: Arc Academy <contact@arcacademy.sh>
pkgname=arct-terminal
pkgver=0.1.0
pkgrel=1
pkgdesc="Learn shell commands interactively with AI-powered explanations"
arch=('x86_64' 'aarch64')
url="https://arcacademy.sh"
license=('MIT')
depends=()
makedepends=('cargo' 'git')
provides=('arct')
conflicts=('arct')
source=("git+https://github.com/arc-academy/terminal.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
  cd "$srcdir/terminal"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --locked --all-features --target-dir=target
}

check() {
  cd "$srcdir/terminal"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --release --locked --target-dir=target
}

package() {
  cd "$srcdir/terminal"
  install -Dm755 "target/release/arct" "$pkgdir/usr/bin/arct"
  install -Dm644 README.md "$pkgdir/usr/share/doc/${pkgname}/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
